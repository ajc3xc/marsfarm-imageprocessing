#!/bin/bash

set -Eeo pipefail
# ACTIVATE ANACONDA
eval "$(conda shell.bash hook)"
conda activate plantenv_pcv4_jupyter

#script test inputs
local bucket_name=$1
local folder_name=$2
local outputs_superfolder=$3

#shows you what node jupyter lab is running on
srun python3 detect_plant.py $bucket_name $folder_name $outputs_superfolder